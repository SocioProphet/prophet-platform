# WordOps Matrix local homeserver profile

WORDOPS_SYNAPSE_IMAGE=matrixdotorg/synapse:v1.131.0

WORDOPS_PUBLIC_SERVER_NAME=wordops-public.localhost
WORDOPS_PRIVATE_SERVER_NAME=wordops-private.localhost

# Base URLs advertised by Synapse and Matrix .well-known metadata.
WORDOPS_MATRIX_EDGE_BASE_URL=http://localhost:8088
WORDOPS_PUBLIC_BASE_URL=http://localhost:8088/public
WORDOPS_PRIVATE_BASE_URL=http://localhost:8088/private

# Direct local container ports used for local smoke checks and debugging.
WORDOPS_PUBLIC_DIRECT_URL=http://localhost:8008
WORDOPS_PRIVATE_DIRECT_URL=http://localhost:8018
WORDOPS_PUBLIC_CLIENT_PORT=8008
WORDOPS_PRIVATE_CLIENT_PORT=8018
WORDOPS_MATRIX_EDGE_PORT=8088

WORDOPS_PUBLIC_DB_NAME=synapse_public
WORDOPS_PUBLIC_DB_USER=synapse_public
WORDOPS_PUBLIC_DB_PASSWORD=change-public-db-password

WORDOPS_PRIVATE_DB_NAME=synapse_private
WORDOPS_PRIVATE_DB_USER=synapse_private
WORDOPS_PRIVATE_DB_PASSWORD=change-private-db-password

WORDOPS_PUBLIC_ENABLE_REGISTRATION=false
WORDOPS_PRIVATE_ENABLE_REGISTRATION=false
