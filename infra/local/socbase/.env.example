# Local-dev Socbase secrets — copy to `.env` (gitignored) IN THIS DIRECTORY and
# fill each with any throwaway value, e.g. `openssl rand -hex 16`. These are
# local-only and ephemeral; never reuse them for anything real. Left BLANK on
# purpose so this template carries no credential literal (the repo's secret
# scanner rejects those). The compose file's `env_file:` loads .env from here.
#
#   cp infra/local/socbase/.env.example infra/local/socbase/.env
#   # edit .env, then:
#   docker compose -f infra/local/docker-compose.socbase.yml up
#
# SOCBASE_JWT_SECRET must match whatever you pass to scripts/socbase-mint-keys.sh.
POSTGRES_PASSWORD=
SOCBASE_JWT_SECRET=
SOCBASE_AUTHENTICATOR_PASSWORD=
