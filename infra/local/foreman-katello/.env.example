# Copy to .env and fill in before first `docker compose up`
# Never commit .env — it is gitignored

# Foreman admin credentials
FOREMAN_ADMIN_USER=admin
FOREMAN_ADMIN_PASSWORD=

# Initial organization and location (created by the installer)
FOREMAN_ORG=SocioProphet
FOREMAN_LOCATION=default

# PostgreSQL sidecar
KATELLO_PG_DB=foreman
KATELLO_PG_USER=foreman
KATELLO_PG_PASSWORD=

# Port overrides (optional — defaults match the compose file)
# KATELLO_PG_PORT=5435
# KATELLO_REDIS_PORT=6381
