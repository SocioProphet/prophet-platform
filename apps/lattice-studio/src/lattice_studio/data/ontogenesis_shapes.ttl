    sh:property [ sh:datatype xsd:boolean ;
            sh:minCount 1 ;
            sh:path epi:hardwareOptIn ],
        [ sh:datatype xsd:integer ;
            sh:minCount 1 ;
            sh:path epi:qubitBudget ] ;
    sh:targetClass epi:QuantumLane .

