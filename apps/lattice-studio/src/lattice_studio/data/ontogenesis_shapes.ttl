@prefix : <https://socioprophet.github.io/ontogenesis/shapes/parsing-gates#> .
@prefix action: <https://socioprophet.github.io/ontogenesis/middle/action#> .
@prefix apt: <https://socioprophet.github.io/ontogenesis/domains/agentic-purple-team#> .
@prefix banking: <https://socioprophet.github.io/ontogenesis/domains/banking#> .
@prefix biz: <https://socioprophet.github.io/ontogenesis/domains/business#> .
@prefix bizd: <https://socioprophet.github.io/ontogenesis/domains/business/drivers#> .
@prefix bizm: <https://socioprophet.github.io/ontogenesis/domains/business/metrics#> .
@prefix c2: <https://socioprophet.github.io/ontogenesis/domains/defense-c2#> .
@prefix capd: <https://socioprophet.github.io/ontogenesis/prophet#capd#> .
@prefix ces: <https://socioprophet.github.io/ontogenesis/platform/corpus-event#> .
@prefix core: <https://socioprophet.github.io/ontogenesis/Platform/Parsing/core#> .
@prefix cs: <https://socioprophet.github.io/ontogenesis/domains/cybernetic-self#> .
@prefix cstack: <https://socioprophet.github.io/ontogenesis/civic-stack#> .
@prefix cti: <https://socioprophet.github.io/ontogenesis/domains/threat-intel#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix epi: <https://socioprophet.github.io/ontogenesis/epi#> .
@prefix fin: <https://socioprophet.github.io/ontogenesis/domains/finance#> .
@prefix fraud: <https://socioprophet.github.io/ontogenesis/domains/fraud#> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix gi: <https://socioprophet.github.io/ontogenesis/platform/governed-intelligence#> .
@prefix hdt: <https://socioprophet.dev/ont/ontogenesis#> .
@prefix hp: <https://socioprophet.github.io/ontogenesis/Platform/Parsing/hypergraph-promotion#> .
@prefix inv: <https://socioprophet.github.io/ontogenesis/domains/investigation#> .
@prefix iw: <https://socioprophet.github.io/ontogenesis/domains/institutional-work#> .
@prefix kc: <https://socioprophet.github.io/ontogenesis/platform/knowledge-context#> .
@prefix kcc: <https://socioprophet.github.io/ontogenesis/domains/knowledge-commons-canon#> .
@prefix kgl: <https://socioprophet.github.io/ontogenesis/middle/kg-lifecycle#> .
@prefix legal: <https://socioprophet.github.io/ontogenesis/domains/legal#> .
@prefix math: <https://socioprophet.github.io/ontogenesis/domains/math#> .
@prefix ms: <https://socioprophet.org/ont/michael#> .
@prefix ngov: <https://socioprophet.github.io/ontogenesis/middle/named-graph-governance#> .
@prefix nl: <https://socioprophet.github.io/ontogenesis/noether#> .
@prefix oq: <https://socioprophet.github.io/ontogenesis/platform/oq#> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix party: <https://socioprophet.github.io/ontogenesis/domains/party#> .
@prefix pb: <https://socioprophet.github.io/ontogenesis/platform/path-b#> .
@prefix prop: <https://socioprophet.github.io/ontogenesis/prophet#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix ps: <https://socioprophet.github.io/ontogenesis/domains/product-service#> .
@prefix rcg: <https://socioprophet.github.io/ontogenesis/middle/reciprocal-channel-governance#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rfail: <https://socioprophet.github.io/ontogenesis/platform/reasoning-failure#> .
@prefix sc: <https://socioprophet.github.io/ontogenesis/domains/supply-chain#> .
@prefix scen: <https://socioprophet.github.io/ontogenesis/domains/adversarial-scenario#> .
@prefix sdo: <https://socioprophet.github.io/ontogenesis/platform/sdo#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shp: <https://socioprophet.github.io/ontogenesis/domains/smart-home-privacy#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix smap: <https://socioprophet.github.io/ontogenesis/middle/semantic-mapping#> .
@prefix sp: <https://socioprophet.com/ontology/v0#> .
@prefix st: <https://socioprophet.github.io/ontogenesis/domains/security-tools#> .
@prefix systema: <https://socioprophet.github.io/ontogenesis/systema#> .
@prefix tf: <https://socioprophet.github.io/ontogenesis/domains/tritfabric#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix twin: <https://socioprophet.org/ont/twin#> .
@prefix upper: <https://socioprophet.github.io/ontogenesis/upper#> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .
@prefix vfg: <https://socioprophet.dev/ont/valueflows-governed#> .
@prefix view: <https://socioprophet.github.io/ontogenesis/platform/view#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

sp:EventIRShape a sh:NodeShape ;
    sh:property [ sh:minCount 1 ;
            sh:path sp:hasScope ],
        [ sh:minCount 1 ;
            sh:path sp:hasFeatureAtom ],
        [ sh:minCount 1 ;
            sh:path sp:hasEvidence ] ;
    sh:targetClass sp:EventIR .

sp:LinkShape a sh:NodeShape ;
    sh:property [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sp:subjectEntity ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sp:objectEntity ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sp:hasLinkState ] ;
    sh:targetClass sp:Link .

sp:ProofArtifactShape a sh:NodeShape ;
    sh:property [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sp:decisionResult ],
        [ sh:minCount 1 ;
            sh:path sp:inputHash ],
        [ sh:minCount 1 ;
            sh:path sp:replayHook ],
        [ sh:minCount 1 ;
            sh:path sp:signatureText ] ;
    sh:targetClass sp:ProofArtifact .

sp:SurfaceShape a sh:NodeShape ;
    sh:or ( [ sh:property [ sh:minCount 1 ;
                        sh:path sp:landingRoute ] ] [ sh:property [ sh:minCount 1 ;
                        sh:path sp:docsRoute ] ] ) ;
    sh:property [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sp:hasCategory ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sp:hasStatus ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sp:homepageVisible ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sp:nextActionText ] ;
    sh:targetClass sp:Surface .

hdt:FHIRResourceShape a sh:NodeShape ;
    sh:property [ sh:in ( hdt:ABSENT hdt:SEEDED hdt:NORMALIZED hdt:LINKED hdt:TRUSTED hdt:ACTIONABLE hdt:DELIVERED ) ;
            sh:minCount 1 ;
            sh:path hdt:hasOmegaState ],
        [ sh:datatype xsd:integer ;
            sh:minInclusive 0 ;
            sh:path hdt:stepsToTruth ],
        [ sh:class hdt:MembershipVector ;
            sh:minCount 1 ;
            sh:path hdt:hasMembership ] ;
    sh:targetClass hdt:FHIRResource .

hdt:MembershipVectorShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:decimal ;
            sh:maxInclusive 1 ;
            sh:minInclusive 0 ;
            sh:path hdt:mCBD ],
        [ sh:datatype xsd:decimal ;
            sh:maxInclusive 1 ;
            sh:minInclusive 0 ;
            sh:path hdt:mCGT ],
        [ sh:datatype xsd:decimal ;
            sh:maxInclusive 1 ;
            sh:minInclusive 0 ;
            sh:path hdt:mNHY ] ;
    sh:targetClass hdt:MembershipVector .

vfg:CairnCheckpointShape a sh:NodeShape ;
    sh:property [ sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path vfg:processRunId ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path vfg:stateProjectionName ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path vfg:materializedStateHash ] ;
    sh:targetClass vfg:CairnCheckpoint .

vfg:CapabilityGrantShape a sh:NodeShape ;
    sh:property [ sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path vfg:delegationId ],
        [ sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path vfg:granteeActorId ],
        [ sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path vfg:groupId ],
        [ sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path vfg:processRunId ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path vfg:capability ],
        [ sh:datatype xsd:string ;
            sh:in ( "active" "revoked" "expired" ) ;
            sh:minCount 1 ;
            sh:path vfg:status ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:path vfg:revokedAt ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path vfg:revokedBy ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path vfg:revocationReason ] ;
    sh:sparql [ sh:message "Revoked capability grants must provide revokedAt and revokedBy." ;
            sh:select """
      SELECT $this WHERE {
        $this vfg:status "revoked" .
        FILTER ( NOT EXISTS { $this vfg:revokedAt ?t . } || NOT EXISTS { $this vfg:revokedBy ?a . } )
      }
    """ ] ;
    sh:targetClass vfg:CapabilityGrant .

vfg:CommitmentShape a sh:NodeShape ;
    sh:property [ sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path vfg:taskId ],
        [ sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path vfg:debtorActorId ],
        [ sh:datatype xsd:string ;
            sh:in ( "accepted" "in_progress" "fulfilled" "released" "reassigned" "canceled" ) ;
            sh:minCount 1 ;
            sh:path vfg:status ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:path vfg:progressPercent ] ;
    sh:targetClass vfg:Commitment .

vfg:DelegationShape a sh:NodeShape ;
    sh:property [ sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path vfg:grantorActorId ],
        [ sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path vfg:granteeActorId ],
        [ sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path vfg:groupId ],
        [ sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path vfg:processRunId ],
        [ sh:datatype xsd:string ;
            sh:in ( "active" "revoked" "expired" ) ;
            sh:minCount 1 ;
            sh:path vfg:status ],
        [ sh:datatype xsd:dateTime ;
            sh:minCount 1 ;
            sh:path vfg:validFrom ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:path vfg:revokedAt ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path vfg:revokedBy ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path vfg:revocationReason ] ;
    sh:sparql [ sh:message "Revoked delegations must provide revokedAt and revokedBy." ;
            sh:select """
      SELECT $this WHERE {
        $this vfg:status "revoked" .
        FILTER ( NOT EXISTS { $this vfg:revokedAt ?t . } || NOT EXISTS { $this vfg:revokedBy ?a . } )
      }
    """ ] ;
    sh:targetClass vfg:Delegation .

vfg:ProcessRunShape a sh:NodeShape ;
    sh:property [ sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path vfg:groupId ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path vfg:canceledBy ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path vfg:cancellationReason ],
        [ sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path vfg:createdBy ],
        [ sh:datatype xsd:string ;
            sh:in ( "active" "completed" "canceled" ) ;
            sh:minCount 1 ;
            sh:path vfg:status ],
        [ sh:datatype xsd:dateTime ;
            sh:minCount 1 ;
            sh:path vfg:startedAt ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:path vfg:completedAt ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:path vfg:canceledAt ] ;
    sh:sparql [ sh:message "Completed process runs must provide completedAt." ;
            sh:select """
      SELECT $this WHERE {
        $this vfg:status "completed" .
        FILTER NOT EXISTS { $this vfg:completedAt ?completedAt . }
      }
    """ ],
        [ sh:message "Canceled process runs must provide canceledAt and canceledBy." ;
            sh:select """
      SELECT $this WHERE {
        $this vfg:status "canceled" .
        FILTER ( NOT EXISTS { $this vfg:canceledAt ?t . } || NOT EXISTS { $this vfg:canceledBy ?a . } )
      }
    """ ] ;
    sh:targetClass vfg:ProcessRun .

vfg:TaskShape a sh:NodeShape ;
    sh:property [ sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path vfg:groupId ],
        [ sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path vfg:processRunId ],
        [ sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path vfg:offeredBy ],
        [ sh:datatype xsd:string ;
            sh:in ( "offered" "accepted" "in_progress" "completed" "canceled" ) ;
            sh:minCount 1 ;
            sh:path vfg:status ],
        [ sh:datatype xsd:dateTime ;
            sh:minCount 1 ;
            sh:path vfg:dueAt ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:path vfg:completedAt ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:path vfg:canceledAt ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path vfg:canceledBy ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path vfg:cancellationReason ] ;
    sh:sparql [ sh:message "Completed tasks must provide completedAt." ;
            sh:select """
      SELECT $this WHERE {
        $this vfg:status "completed" .
        FILTER NOT EXISTS { $this vfg:completedAt ?completedAt . }
      }
    """ ],
        [ sh:message "Canceled tasks must provide canceledAt and canceledBy." ;
            sh:select """
      SELECT $this WHERE {
        $this vfg:status "canceled" .
        FILTER ( NOT EXISTS { $this vfg:canceledAt ?t . } || NOT EXISTS { $this vfg:canceledBy ?a . } )
      }
    """ ] ;
    sh:targetClass vfg:Task .

cstack:AttestationEventShape a sh:NodeShape ;
    sh:message "An attestation event must carry either a signature or an evidence reference." ;
    sh:or ( [ sh:property [ sh:datatype xsd:string ;
                        sh:minCount 1 ;
                        sh:path cstack:signature ] ] [ sh:property [ sh:datatype xsd:string ;
                        sh:minCount 1 ;
                        sh:path cstack:hasEvidenceRef ] ] ) ;
    sh:property [ sh:message "An attestation event must identify the attested target." ;
            sh:minCount 1 ;
            sh:path cstack:attestsTarget ],
        [ sh:datatype xsd:dateTime ;
            sh:message "An attestation event must carry a generation time." ;
            sh:minCount 1 ;
            sh:path prov:generatedAtTime ] ;
    sh:targetClass cstack:AttestationEvent .

cstack:CivicChangeEventShape a sh:NodeShape ;
    sh:property [ sh:message "A civic-stack change event must carry a TIME timestamp." ;
            sh:minCount 1 ;
            sh:path time:inXSDDateTime ],
        [ sh:message "A civic-stack change event must identify an associated agent." ;
            sh:minCount 1 ;
            sh:path prov:wasAssociatedWith ] ;
    sh:targetClass cstack:ChangeEvent .

cstack:MembershipShape a sh:NodeShape ;
    sh:property [ sh:maxCount 1 ;
            sh:message "A civic membership must identify exactly one member." ;
            sh:minCount 1 ;
            sh:path org:member ],
        [ sh:maxCount 1 ;
            sh:message "A civic membership must identify exactly one organization." ;
            sh:minCount 1 ;
            sh:path org:organization ],
        [ sh:message "A civic membership must identify at least one role." ;
            sh:minCount 1 ;
            sh:path org:role ] ;
    sh:targetClass org:Membership .

cstack:OrgChangeEventShape a sh:NodeShape ;
    sh:property [ sh:message "An ORG change event must carry a TIME timestamp." ;
            sh:minCount 1 ;
            sh:path time:inXSDDateTime ],
        [ sh:message "An ORG change event must identify an associated agent." ;
            sh:minCount 1 ;
            sh:path prov:wasAssociatedWith ] ;
    sh:targetClass org:ChangeEvent .

cstack:RegulatedDatasetShape a sh:NodeShape ;
    sh:property [ sh:message "A regulated dataset must identify its generating activity or service." ;
            sh:minCount 1 ;
            sh:path prov:wasGeneratedBy ],
        [ sh:message "A regulated dataset must cite at least one access basis." ;
            sh:minCount 1 ;
            sh:path cstack:hasAccessBasis ],
        [ sh:datatype xsd:string ;
            sh:message "A regulated dataset must carry a provenance reference." ;
            sh:minCount 1 ;
            sh:path cstack:hasProvenanceRef ] ;
    sh:targetClass cstack:RegulatedDataset .

cstack:RegulatedServiceShape a sh:NodeShape ;
    sh:property [ sh:message "A regulated civic service must cite at least one legal basis." ;
            sh:minCount 1 ;
            sh:path cstack:hasLegalBasis ],
        [ sh:message "A regulated civic service must identify a responsible post." ;
            sh:minCount 1 ;
            sh:path cstack:hasResponsiblePost ] ;
    sh:targetClass cstack:RegulatedService .

cstack:ServiceEventShape a sh:NodeShape ;
    sh:property [ sh:message "A civic service event must identify the generating service or activity." ;
            sh:minCount 1 ;
            sh:path prov:wasGeneratedBy ],
        [ sh:message "A civic service event must cite legal basis." ;
            sh:minCount 1 ;
            sh:path cstack:hasLegalBasis ],
        [ sh:datatype xsd:string ;
            sh:message "A civic service event must carry an evidence reference." ;
            sh:minCount 1 ;
            sh:path cstack:hasEvidenceRef ] ;
    sh:targetClass cstack:ServiceEvent .

cstack:SiteAddressOrGeometryShape a sh:NodeShape ;
    sh:message "A civic site must carry GeoSPARQL geometry or a vCard address." ;
    sh:or ( [ sh:property [ sh:minCount 1 ;
                        sh:path geo:hasGeometry ] ] [ sh:property [ sh:minCount 1 ;
                        sh:path vcard:hasAddress ] ] ) ;
    sh:targetClass org:Site .

scen:AdversarialScenarioShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:message "AdversarialScenario must have a stable adversarial-scenario:* ID." ;
            sh:minCount 1 ;
            sh:path scen:scenarioId ;
            sh:pattern "^adversarial-scenario:[a-z0-9][a-z0-9._:-]*$" ],
        [ sh:datatype xsd:boolean ;
            sh:hasValue false ;
            sh:message "AdversarialScenario examples must not authorize engagement." ;
            sh:minCount 1 ;
            sh:path scen:engagementAuthorizationAuthority ],
        [ sh:datatype xsd:boolean ;
            sh:hasValue false ;
            sh:message "AdversarialScenario examples must not activate downstream delivery." ;
            sh:minCount 1 ;
            sh:path scen:activationAllowed ],
        [ sh:datatype xsd:string ;
            sh:message "AdversarialScenario must declare a scenario class." ;
            sh:minCount 1 ;
            sh:path scen:scenarioClass ],
        [ sh:class scen:ScenarioObjective ;
            sh:message "AdversarialScenario must reference a ScenarioObjective." ;
            sh:minCount 1 ;
            sh:path scen:hasObjective ],
        [ sh:class scen:ChannelSubstrate ;
            sh:message "AdversarialScenario must reference at least one ChannelSubstrate." ;
            sh:minCount 1 ;
            sh:path scen:usesChannelSubstrate ],
        [ sh:class apt:EvidenceEnvelope ;
            sh:message "AdversarialScenario must reference at least one EvidenceEnvelope." ;
            sh:minCount 1 ;
            sh:path scen:hasEvidenceEnvelope ],
        [ sh:class apt:RunReceipt ;
            sh:message "AdversarialScenario must reference a runtime decision receipt before scenario export can be treated as governed." ;
            sh:minCount 1 ;
            sh:path scen:hasRuntimeDecisionReceipt ],
        [ sh:class scen:ScenarioNonClaim ;
            sh:message "AdversarialScenario must carry explicit non-claims." ;
            sh:minCount 3 ;
            sh:path scen:hasScenarioNonClaim ],
        [ sh:datatype xsd:boolean ;
            sh:hasValue false ;
            sh:message "AdversarialScenario examples must not claim runtime authority." ;
            sh:minCount 1 ;
            sh:path scen:runtimeAuthority ],
        [ sh:datatype xsd:boolean ;
            sh:hasValue false ;
            sh:message "AdversarialScenario examples must not claim procedure execution authority." ;
            sh:minCount 1 ;
            sh:path scen:procedureExecutionAuthority ] ;
    sh:targetClass scen:AdversarialScenario .

scen:ClaimPromotionStateShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:in ( "raw" "hypothesis" "triaged" "blocked" ) ;
            sh:message "ClaimPromotionState examples must remain raw, hypothesis, triaged, or blocked." ;
            sh:minCount 1 ;
            sh:path scen:promotionState ],
        [ sh:datatype xsd:boolean ;
            sh:hasValue false ;
            sh:message "ClaimPromotionState must not allow finding promotion in examples." ;
            sh:minCount 1 ;
            sh:path scen:findingAllowed ],
        [ sh:datatype xsd:boolean ;
            sh:hasValue false ;
            sh:message "ClaimPromotionState must not allow memory update in examples." ;
            sh:minCount 1 ;
            sh:path scen:memoryUpdateAllowed ] ;
    sh:targetClass scen:ClaimPromotionState .

scen:MemoryEffectShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:boolean ;
            sh:hasValue false ;
            sh:message "MemoryEffect must not authorize durable writeback." ;
            sh:minCount 1 ;
            sh:path scen:writebackAllowed ],
        [ sh:datatype xsd:boolean ;
            sh:hasValue true ;
            sh:message "MemoryEffect must require proposal routing." ;
            sh:minCount 1 ;
            sh:path scen:proposalRequired ],
        [ sh:datatype xsd:string ;
            sh:in ( "pending_review" "blocked" ) ;
            sh:message "MemoryEffect review state must remain pending_review or blocked." ;
            sh:minCount 1 ;
            sh:path scen:reviewState ] ;
    sh:targetClass scen:MemoryEffect .

scen:TechniqueAnnotationBoundaryShape a sh:NodeShape ;
    sh:property [ sh:class apt:Technique ;
            sh:message "Technique mappings are annotations only; authority/evidence/promotion must be represented separately." ;
            sh:path scen:mapsToTechniqueAnnotation ],
        [ sh:class scen:AbstentionRule ;
            sh:message "Technique-annotated scenarios require at least one abstention rule." ;
            sh:minCount 1 ;
            sh:path scen:requiresAbstentionRule ] ;
    sh:targetClass scen:AdversarialScenario .

apt:AgenticPurpleTeamActionShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:in ( "read_only" "synthetic_only" "dry_run" "write_with_gate" "blocked" ) ;
            sh:message "Agentic purple-team actions must declare a safety mode." ;
            sh:minCount 1 ;
            sh:path apt:safetyMode ],
        [ sh:datatype xsd:string ;
            sh:in ( "read" "synthetic_event" "dry_run" "network_call" "write" "deployment" "destructive_action" "credential_access" "memory_write" ) ;
            sh:message "Agentic purple-team actions must declare a governed action class." ;
            sh:minCount 1 ;
            sh:path apt:actionClass ] ;
    sh:targetClass apt:AgenticPurpleTeamAction .

apt:AtomicTestCaseShape a sh:NodeShape ;
    sh:property [ sh:class apt:Technique ;
            sh:message "AtomicTestCase must map to at least one attack technique or local equivalent." ;
            sh:minCount 1 ;
            sh:path apt:mapsToTechnique ],
        [ sh:datatype xsd:string ;
            sh:in ( "synthetic_only" "dry_run" "read_only" ) ;
            sh:message "AtomicTestCase examples must remain synthetic/read-only/dry-run in Ontogenesis." ;
            sh:minCount 1 ;
            sh:path apt:safetyMode ] ;
    sh:targetClass apt:AtomicTestCase .

apt:ControlLoopRunShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:message "ControlLoopRun must have a scope-d run ID." ;
            sh:minCount 1 ;
            sh:path apt:runId ;
            sh:pattern "^scope-d-[A-Za-z0-9._:-]+$" ],
        [ sh:class apt:SafetyBoundary ;
            sh:message "ControlLoopRun must reference a SafetyBoundary." ;
            sh:minCount 1 ;
            sh:path apt:hasSafetyBoundary ],
        [ sh:class apt:RunReceipt ;
            sh:message "ControlLoopRun must reference a RunReceipt." ;
            sh:minCount 1 ;
            sh:path apt:hasReceipt ] ;
    sh:targetClass apt:ControlLoopRun .

apt:TechniqueShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:message "Technique must have a technique ID." ;
            sh:minCount 1 ;
            sh:path apt:techniqueId ] ;
    sh:targetClass apt:Technique .

banking:FilingPackShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path banking:publicationStatus ] ;
    sh:targetClass banking:FilingPack .

banking:LegalEntityShape a sh:NodeShape ;
    sh:property [ sh:minCount 0 ;
            sh:path banking:hasPortfolio ] ;
    sh:targetClass banking:LegalEntity .

cs:CyberneticSelfShape a sh:NodeShape ;
    sh:property [ sh:class cs:IdentityAnchor ;
            sh:minCount 1 ;
            sh:path cs:anchoredBy ],
        [ sh:class cs:ObjectiveFunction ;
            sh:minCount 1 ;
            sh:path cs:hasObjectiveFunction ],
        [ sh:class cs:FederatedEmbodiment ;
            sh:minCount 1 ;
            sh:path cs:hasEmbodiment ],
        [ sh:class cs:Chamber ;
            sh:minCount 1 ;
            sh:path cs:hasChamber ],
        [ sh:class cs:GovernanceCompact ;
            sh:minCount 1 ;
            sh:path cs:governedByCompact ],
        [ sh:class cs:IdentityAnchor ;
            sh:minCount 1 ;
            sh:path cs:anchoredBy ],
        [ sh:class cs:ObjectiveFunction ;
            sh:minCount 1 ;
            sh:path cs:hasObjectiveFunction ],
        [ sh:class cs:FederatedEmbodiment ;
            sh:minCount 1 ;
            sh:path cs:hasEmbodiment ],
        [ sh:class cs:Chamber ;
            sh:minCount 1 ;
            sh:path cs:hasChamber ],
        [ sh:class cs:GovernanceCompact ;
            sh:minCount 1 ;
            sh:path cs:governedByCompact ] ;
    sh:targetClass cs:CyberneticSelf .

c2:MissionShape a sh:NodeShape ;
    sh:property [ sh:message "A mission must declare a mission identifier." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path c2:missionIdentifier ],
        [ sh:class c2:CourseOfAction ;
            sh:message "A mission must declare at least one course of action." ;
            sh:minCount 1 ;
            sh:path c2:hasCourseOfAction ],
        [ sh:class c2:RuleOfEngagement ;
            sh:message "A mission must declare applicable rules of engagement or operating constraints." ;
            sh:minCount 1 ;
            sh:path c2:governedByROE ] ;
    sh:targetClass c2:Mission .

c2:ReadinessAssessmentShape a sh:NodeShape ;
    sh:property [ sh:message "A readiness assessment must declare a readiness level." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path c2:readinessLevel ] ;
    sh:targetClass c2:ReadinessAssessment .

fin:FinancialTransactionShape a sh:NodeShape ;
    sh:property [ sh:message "A financial transaction must declare a sender." ;
            sh:minCount 1 ;
            sh:path fin:hasSender ],
        [ sh:message "A financial transaction must declare a recipient." ;
            sh:minCount 1 ;
            sh:path fin:hasRecipient ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:message "A financial transaction must declare one decimal amount." ;
            sh:minCount 1 ;
            sh:path fin:amount ],
        [ sh:maxCount 1 ;
            sh:message "A financial transaction must declare a currency." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path fin:currency ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:message "A financial transaction must declare a transaction timestamp." ;
            sh:minCount 1 ;
            sh:path fin:transactedAt ] ;
    sh:targetClass fin:FinancialTransaction .

fin:RiskScoreShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:maxInclusive 1.0 ;
            sh:message "A risk score must declare a normalized decimal risk value." ;
            sh:minCount 1 ;
            sh:minInclusive 0.0 ;
            sh:path fin:riskValue ],
        [ sh:message "A risk score must declare the model or policy that produced it." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path fin:riskModel ] ;
    sh:targetClass fin:RiskScore .

fraud:ConfirmedFraudRequiresLabelProvenanceShape a sh:NodeShape ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "A FraudOutcome with label value confirmed_fraud must have fraud:hasLabelProvenance." ;
            sh:select """
      PREFIX fraud: <https://socioprophet.github.io/ontogenesis/domains/fraud#>
      SELECT $this WHERE {
        $this fraud:labelValue "confirmed_fraud" .
        FILTER NOT EXISTS { $this fraud:hasLabelProvenance ?provenance . }
      }
    """ ] ;
    sh:targetClass fraud:FraudOutcome .

fraud:FraudControlActionShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path fraud:actionKind ],
        [ sh:datatype xsd:boolean ;
            sh:minCount 1 ;
            sh:path fraud:isHumanImpacting ] ;
    sh:targetClass fraud:FraudControlAction .

fraud:FraudDecisionReceiptShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path fraud:decisionId ],
        [ sh:class fraud:FraudEvent ;
            sh:minCount 1 ;
            sh:path fraud:evaluatesEvent ],
        [ sh:class fraud:FraudEvidenceBundle ;
            sh:minCount 1 ;
            sh:path fraud:hasEvidenceBundle ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path fraud:claimBoundary ] ;
    sh:targetClass fraud:FraudDecisionReceipt .

fraud:FraudEvidenceBundleShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path fraud:claimBoundary ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:maxInclusive 1.0 ;
            sh:minInclusive 0.0 ;
            sh:path fraud:modelScore ] ;
    sh:targetClass fraud:FraudEvidenceBundle .

fraud:FraudFeatureHealthShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path fraud:featureName ],
        [ sh:datatype xsd:decimal ;
            sh:path fraud:missingnessDelta ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path fraud:operationalAvailability ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path fraud:recommendedHandling ] ;
    sh:targetClass fraud:FraudFeatureHealth .

fraud:FraudLabelProvenanceShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path fraud:labelValue ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path fraud:labelSource ],
        [ sh:datatype xsd:decimal ;
            sh:maxInclusive 1.0 ;
            sh:minCount 1 ;
            sh:minInclusive 0.0 ;
            sh:path fraud:labelConfidence ] ;
    sh:targetClass fraud:FraudLabelProvenance .

fraud:FraudScenarioCandidateShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path fraud:scenarioStatus ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path fraud:claimBoundary ] ;
    sh:targetClass fraud:FraudScenarioCandidate .

fraud:HumanImpactingAuthorizedActionShape a sh:NodeShape ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "A FraudDecisionReceipt that authorizes a human-impacting FraudControlAction must include fraud:authorizedByPolicyRef." ;
            sh:select """
      PREFIX fraud: <https://socioprophet.github.io/ontogenesis/domains/fraud#>
      SELECT $this WHERE {
        $this fraud:authorizesAction ?action .
        ?action fraud:isHumanImpacting true .
        FILTER NOT EXISTS { $this fraud:authorizedByPolicyRef ?policyRef . }
      }
    """ ] ;
    sh:targetClass fraud:FraudDecisionReceipt .

fraud:NoBenchmarkAsProductionValidationShape a sh:NodeShape ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "A FraudEvidenceBundle with fraud:benchmarkMetric must not assert production validation directly; benchmark metrics alone do not prove production readiness." ;
            sh:select """
      PREFIX fraud: <https://socioprophet.github.io/ontogenesis/domains/fraud#>
      SELECT $this WHERE {
        $this fraud:benchmarkMetric ?metric .
        $this fraud:assertsProductionValidationClaim ?claim .
      }
    """ ] ;
    sh:targetClass fraud:FraudEvidenceBundle .

fraud:NoModelScoreAsFraudProofShape a sh:NodeShape ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "A FraudEvidenceBundle with fraud:modelScore must not assert fraud:FraudProofClaim directly; model score is a risk signal, not proof." ;
            sh:select """
      PREFIX fraud: <https://socioprophet.github.io/ontogenesis/domains/fraud#>
      SELECT $this WHERE {
        $this fraud:modelScore ?score .
        $this fraud:assertsProofClaim ?claim .
      }
    """ ] ;
    sh:targetClass fraud:FraudEvidenceBundle .

iw:GovernedActionShape a sh:NodeShape ;
    sh:property [ sh:class iw:Asset ;
            sh:minCount 1 ;
