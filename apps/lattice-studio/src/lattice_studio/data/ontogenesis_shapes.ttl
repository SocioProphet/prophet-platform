ces:SourceProvenanceShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path ces:sourceQuality ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path ces:evidenceRef ] ;
    sh:targetClass ces:SourceProvenance .

gi:ActionProposalShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path gi:actionType ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path gi:scope ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path gi:expectedEffect ],
        [ sh:class gi:Evidence ;
            sh:minCount 1 ;
            sh:path gi:hasEvidence ] ;
    sh:targetClass gi:ActionProposal .

gi:AnchorShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path gi:artifactRef ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path gi:selector ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path gi:sourceRef ],
        [ sh:in ( "text_span" "image_region" "geometry" "h3_cell" "code_range" "log_range" "table_cell" "audio_segment" "video_clip" "generic_selector" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path gi:selectorType ] ;
    sh:targetClass gi:Anchor .

gi:ClaimShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path gi:subjectRef ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path gi:predicateRef ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path gi:objectRef ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path gi:contextRef ],
        [ sh:class gi:Evidence ;
            sh:minCount 1 ;
            sh:path gi:hasEvidence ],
        [ sh:in ( "proposed" "provisional" "admitted" "denied" "require_review" "superseded" "revoked" "expired" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path gi:lifecycleStatus ] ;
    sh:targetClass gi:Claim .

gi:EvidenceShape a sh:NodeShape ;
    sh:property [ sh:class gi:Anchor ;
            sh:minCount 1 ;
            sh:path gi:hasAnchor ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path gi:sourceRef ],
        [ sh:in ( "proposed" "provisional" "admitted" "denied" "require_review" "superseded" "revoked" "expired" ) ;
            sh:minCount 1 ;
            sh:path gi:lifecycleStatus ] ;
    sh:targetClass gi:Evidence .

gi:LearningOperationShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path gi:operationScope ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path gi:sourceRef ],
        [ sh:in ( "proposed" "provisional" "admitted" "denied" "require_review" "superseded" "revoked" "expired" ) ;
            sh:minCount 1 ;
            sh:path gi:lifecycleStatus ] ;
    sh:targetClass gi:LearningOperation .

gi:LinkingOperationShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path gi:operationScope ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path gi:sourceRef ],
        [ sh:in ( "proposed" "provisional" "admitted" "denied" "require_review" "superseded" "revoked" "expired" ) ;
            sh:minCount 1 ;
            sh:path gi:lifecycleStatus ] ;
    sh:targetClass gi:LinkingOperation .

gi:NonLearningConstraintShape a sh:NodeShape ;
    sh:property [ sh:class gi:LearningOperation ;
            sh:minCount 1 ;
            sh:path gi:constrainsLearning ],
        [ sh:class gi:ProtectedSignal ;
            sh:minCount 1 ;
            sh:path gi:targetsProtectedSignal ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path gi:sourceRef ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path gi:privacyScope ] ;
    sh:targetClass gi:NonLearningConstraint .

gi:NonLinkabilityConstraintShape a sh:NodeShape ;
    sh:property [ sh:class gi:LinkingOperation ;
            sh:minCount 1 ;
            sh:path gi:constrainsLinking ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path gi:sourceRef ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path gi:privacyScope ] ;
    sh:targetClass gi:NonLinkabilityConstraint .

gi:PolicyDecisionShape a sh:NodeShape ;
    sh:property [ sh:in ( "allow" "deny" "require_review" "provisional" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path gi:decision ],
        [ sh:minCount 1 ;
            sh:path gi:targets ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path gi:sourceRef ] ;
    sh:targetClass gi:PolicyDecision .

gi:PrivacyBoundaryShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path gi:privacyScope ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path gi:sourceRef ],
        [ sh:in ( "proposed" "provisional" "admitted" "denied" "require_review" "superseded" "revoked" "expired" ) ;
            sh:minCount 1 ;
            sh:path gi:lifecycleStatus ] ;
    sh:targetClass gi:PrivacyBoundary .

gi:PrivacyDecisionShape a sh:NodeShape ;
    sh:property [ sh:in ( "allow" "deny" "require_review" "provisional" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path gi:decision ],
        [ sh:minCount 1 ;
            sh:path gi:targets ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path gi:sourceRef ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path gi:privacyBasis ],
        [ sh:in ( "proposed" "provisional" "admitted" "denied" "require_review" "superseded" "revoked" "expired" ) ;
            sh:minCount 1 ;
            sh:path gi:lifecycleStatus ] ;
    sh:targetClass gi:PrivacyDecision .

gi:PrivacyReceiptShape a sh:NodeShape ;
    sh:property [ sh:minCount 1 ;
            sh:path gi:recordsPrivacyOperation ],
        [ sh:class gi:PrivacyDecision ;
            sh:minCount 1 ;
            sh:path gi:hasPrivacyDecision ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path gi:enforcementMode ],
        [ sh:in ( "blocked" "admitted" "minimized" "redacted" "aggregated" "anonymized" "ephemeral_only" "expired" "require_review" ) ;
            sh:minCount 1 ;
            sh:path gi:privacyDisposition ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path gi:inputHash ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path gi:outputHash ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path gi:logRef ],
        [ sh:in ( "proposed" "provisional" "admitted" "denied" "require_review" "superseded" "revoked" "expired" ) ;
            sh:minCount 1 ;
            sh:path gi:lifecycleStatus ] ;
    sh:targetClass gi:PrivacyReceipt .

gi:ProtectedSignalShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path gi:sourceRef ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path gi:privacyScope ],
        [ sh:in ( "proposed" "provisional" "admitted" "denied" "require_review" "superseded" "revoked" "expired" ) ;
            sh:minCount 1 ;
            sh:path gi:lifecycleStatus ] ;
    sh:targetClass gi:ProtectedSignal .

gi:RepresentationPromotionGateShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path gi:promotionRule ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path gi:sourceRef ],
        [ sh:in ( "proposed" "provisional" "admitted" "denied" "require_review" "superseded" "revoked" "expired" ) ;
            sh:minCount 1 ;
            sh:path gi:lifecycleStatus ] ;
    sh:targetClass gi:RepresentationPromotionGate .

gi:RepresentationPromotionShape a sh:NodeShape ;
    sh:property [ sh:class gi:RepresentationStratum ;
            sh:minCount 1 ;
            sh:path gi:fromRepresentationStratum ],
        [ sh:class gi:RepresentationStratum ;
            sh:minCount 1 ;
            sh:path gi:toRepresentationStratum ],
        [ sh:minCount 1 ;
            sh:path gi:promotesRepresentation ],
        [ sh:class gi:RepresentationPromotionGate ;
            sh:minCount 1 ;
            sh:path gi:hasPromotionGate ],
        [ sh:class gi:PolicyDecision ;
            sh:minCount 1 ;
            sh:path gi:requiresPolicyDecision ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path gi:authorityLadderNote ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path gi:sourceRef ],
        [ sh:in ( "proposed" "provisional" "admitted" "denied" "require_review" "superseded" "revoked" "expired" ) ;
            sh:minCount 1 ;
            sh:path gi:lifecycleStatus ] ;
    sh:targetClass gi:RepresentationPromotion .

gi:RepresentationStratumShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path gi:stratumCode ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path gi:sourceRef ],
        [ sh:in ( "proposed" "provisional" "admitted" "denied" "require_review" "superseded" "revoked" "expired" ) ;
            sh:minCount 1 ;
            sh:path gi:lifecycleStatus ] ;
    sh:targetClass gi:RepresentationStratum .

gi:RuntimeReceiptShape a sh:NodeShape ;
    sh:or ( [ sh:minCount 1 ;
                sh:path gi:recordsAction ] [ sh:minCount 1 ;
                sh:path gi:recordsPrivacyOperation ] ) ;
    sh:property [ sh:class gi:PolicyDecision ;
            sh:minCount 1 ;
            sh:path gi:hasPolicyDecision ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path gi:inputHash ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path gi:outputHash ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path gi:logRef ],
        [ sh:in ( "proposed" "provisional" "admitted" "denied" "require_review" "superseded" "revoked" "expired" ) ;
            sh:minCount 1 ;
            sh:path gi:lifecycleStatus ] ;
    sh:targetClass gi:RuntimeReceipt .

gi:VectorCandidateShape a sh:NodeShape ;
    sh:property [ sh:hasValue "candidate_only" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path gi:candidateStatus ],
        [ sh:datatype xsd:decimal ;
            sh:minCount 1 ;
            sh:path gi:similarity ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path gi:matchedRoles ] ;
    sh:targetClass gi:VectorCandidate .

kc:EmbeddingRefShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path kc:embeddingModel ],
        [ sh:class kc:KnowledgeArtifact ;
            sh:minCount 1 ;
            sh:path kc:targetsNode ],
        [ sh:class kc:VectorIndexRef ;
            sh:minCount 1 ;
            sh:path kc:usesVectorIndex ] ;
    sh:targetClass kc:EmbeddingRef .

kc:KnowledgeContextShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path kc:schemaLabel ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path kc:contextLabel ] ;
    sh:targetClass kc:KnowledgeContext .

kc:MentionShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path kc:surfaceForm ],
        [ sh:class kc:Passage ;
            sh:minCount 1 ;
            sh:path kc:inPassage ],
        [ sh:class kc:Entity ;
            sh:minCount 1 ;
            sh:path kc:mentionsEntity ] ;
    sh:targetClass kc:Mention .

kc:PassageShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path kc:artifactId ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path kc:text ] ;
    sh:targetClass kc:Passage .

kc:VectorIndexRefShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path kc:vectorBackend ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path kc:metric ] ;
    sh:targetClass kc:VectorIndexRef .

oq:ClassQueryShape a sh:NodeShape ;
    sh:message "A ClassQuery must specify targetClass." ;
    sh:property [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path oq:targetClass ] ;
    sh:targetClass oq:ClassQuery .

oq:ConstraintQueryShape a sh:NodeShape ;
    sh:message "A ConstraintQuery must specify catalogScope (inherited) and must not override isDryRun to absent." ;
    sh:targetClass oq:ConstraintQuery .

oq:DryRunFailResponseShape a sh:NodeShape ;
    sh:message "A DryRunFailResponse must have resultStatus='dry-run-fail', at least one evidence record, and an errorMessage." ;
    sh:property [ sh:hasValue "dry-run-fail" ;
            sh:path oq:resultStatus ],
        [ sh:minCount 1 ;
            sh:path oq:hasEvidence ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path oq:errorMessage ] ;
    sh:targetClass oq:DryRunFailResponse .

oq:DryRunPassResponseShape a sh:NodeShape ;
    sh:message "A DryRunPassResponse must have resultStatus='dry-run-pass' and at least one evidence record." ;
    sh:property [ sh:hasValue "dry-run-pass" ;
            sh:path oq:resultStatus ],
        [ sh:minCount 1 ;
            sh:path oq:hasEvidence ] ;
    sh:targetClass oq:DryRunPassResponse .

oq:LatticeQueryPlaneBindingShape a sh:NodeShape ;
    sh:message "A LatticeQueryPlaneBinding must declare latticeQueryLanguage='ontology-query', distinguishedFrom, and bindsQuery." ;
    sh:property [ sh:datatype xsd:string ;
            sh:hasValue "ontology-query" ;
            sh:minCount 1 ;
            sh:path oq:latticeQueryLanguage ],
        [ sh:datatype xsd:string ;
            sh:hasValue "sparql" ;
            sh:minCount 1 ;
            sh:path oq:distinguishedFrom ],
        [ sh:minCount 1 ;
            sh:path oq:bindsQuery ] ;
    sh:targetClass oq:LatticeQueryPlaneBinding .

oq:OntologyQueryResponseShape a sh:NodeShape ;
    sh:message "Every OntologyQueryResponse must carry responseId, respondingTo, and resultStatus." ;
    sh:property [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path oq:responseId ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path oq:respondingTo ],
        [ sh:datatype xsd:string ;
            sh:in ( "ok" "error" "dry-run-pass" "dry-run-fail" ) ;
            sh:minCount 1 ;
            sh:path oq:resultStatus ] ;
    sh:targetClass oq:OntologyQueryResponse .

oq:OntologyQueryShape a sh:NodeShape ;
    sh:message "Every OntologyQuery must carry a queryId, queryVersion, catalogScope, requestingAgent, governedByPolicy, and isDryRun." ;
    sh:property [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path oq:queryId ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path oq:queryVersion ],
        [ sh:minCount 1 ;
            sh:path oq:catalogScope ],
        [ sh:minCount 1 ;
            sh:path oq:requestingAgent ],
        [ sh:minCount 1 ;
            sh:path oq:governedByPolicy ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path oq:isDryRun ] ;
    sh:targetClass oq:OntologyQuery .

oq:QueryEvidenceShape a sh:NodeShape ;
    sh:message "Every QueryEvidence must carry evidenceKind, evidenceTimestamp, evidenceSource, and evidenceText." ;
    sh:property [ sh:datatype xsd:string ;
            sh:in ( "policy-check" "catalog-check" "reasoning-trace" "dry-run-check" ) ;
            sh:minCount 1 ;
            sh:path oq:evidenceKind ],
        [ sh:datatype xsd:dateTime ;
            sh:minCount 1 ;
            sh:path oq:evidenceTimestamp ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path oq:evidenceSource ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path oq:evidenceText ] ;
    sh:targetClass oq:QueryEvidence .

oq:ReasoningResultQueryShape a sh:NodeShape ;
    sh:message "A ReasoningResultQuery must declare a reasonerProfile." ;
    sh:property [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path oq:reasonerProfile ] ;
    sh:targetClass oq:ReasoningResultQuery .

oq:SchemaAlignmentQueryShape a sh:NodeShape ;
    sh:message "A SchemaAlignmentQuery must provide both sourceSchema and targetSchema." ;
    sh:property [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path oq:targetSchema ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path oq:sourceSchema ] ;
    sh:targetClass oq:SchemaAlignmentQuery .

oq:ShapeQueryShape a sh:NodeShape ;
    sh:message "A ShapeQuery must specify at least one of targetShape or targetNode." ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "A ShapeQuery must have at least targetShape or targetNode." ;
            sh:select """
      PREFIX oq: <https://socioprophet.github.io/ontogenesis/platform/oq#>
      SELECT ?this WHERE {
        ?this a oq:ShapeQuery .
        FILTER NOT EXISTS { ?this oq:targetShape ?s . }
        FILTER NOT EXISTS { ?this oq:targetNode  ?n . }
      }
    """ ] ;
    sh:targetClass oq:ShapeQuery .

pb:SynergeticPatternShape a sh:NodeShape ;
    sh:property [ sh:minCount 1 ;
            sh:path pb:hasValidationBoundary ],
        [ sh:minCount 1 ;
            sh:path pb:mapsToRepo ] ;
    sh:targetClass pb:SynergeticPattern .

rfail:ReasoningFailureCaseShape a sh:NodeShape ;
    sh:property [ sh:class rfail:ReasoningFailureMode ;
            sh:message "Reasoning failure cases must cite at least one canonical failure mode." ;
            sh:minCount 1 ;
            sh:path rfail:hasFailureMode ],
        [ sh:datatype xsd:string ;
            sh:message "Reasoning failure cases must declare a proposed runtime action." ;
            sh:minCount 1 ;
            sh:path rfail:riskAction ],
        [ sh:class rfail:ReasoningTask ;
            sh:message "Reasoning failure cases must cite the task being evaluated." ;
            sh:minCount 1 ;
            sh:path rfail:hasTask ],
        [ sh:class rfail:Invariant ;
            sh:message "Reasoning failure cases must declare the invariant that should survive perturbation." ;
            sh:minCount 1 ;
            sh:path rfail:hasInvariant ],
        [ sh:class rfail:Verifier ;
            sh:message "Reasoning failure cases must cite a verifier or verifier family." ;
            sh:minCount 1 ;
            sh:path rfail:hasVerifier ],
        [ sh:class rfail:EvidenceReceipt ;
            sh:message "Reasoning failure cases must cite an evidence receipt rather than relying on rationale text." ;
            sh:minCount 1 ;
            sh:path rfail:hasEvidenceReceipt ],
        [ sh:class rfail:ResidualRisk ;
            sh:message "Reasoning failure cases must carry residual risk." ;
            sh:minCount 1 ;
            sh:path rfail:hasResidualRisk ],
        [ sh:datatype xsd:string ;
            sh:in ( "low" "medium" "high" "critical" ) ;
            sh:message "Reasoning failure severity must be low, medium, high, or critical." ;
            sh:minCount 1 ;
            sh:path rfail:severity ] ;
    sh:targetClass rfail:ReasoningFailureCase .

rfail:RelationSemanticsShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:in ( "directed" "undirected" "bidirectional" "n-ary" ) ;
            sh:message "Relation semantics must declare relation direction." ;
            sh:minCount 1 ;
            sh:path rfail:relationDirection ],
        [ sh:datatype xsd:string ;
            sh:in ( "symmetric" "asymmetric" "antisymmetric" "unknown" ) ;
            sh:message "Relation semantics must declare symmetry profile." ;
            sh:minCount 1 ;
            sh:path rfail:symmetryProfile ],
        [ sh:datatype xsd:string ;
            sh:in ( "transitive" "intransitive" "nontransitive" "unknown" ) ;
            sh:message "Relation semantics must declare transitivity profile." ;
            sh:minCount 1 ;
            sh:path rfail:transitivityProfile ] ;
    sh:targetClass rfail:RelationSemantics .

rfail:VerifierShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:in ( "deterministic" "symbolic" "schema" "policy" "tool-backed" "human-review" "llm-judge-advisory" ) ;
            sh:message "Verifier status must identify whether the verifier is deterministic, symbolic, schema, policy, tool-backed, human-review, or LLM-judge advisory." ;
            sh:minCount 1 ;
            sh:path rfail:status ] ;
    sh:targetClass rfail:Verifier .

sdo:AdapterStateShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdo:adapterId ] ;
    sh:targetClass sdo:AdapterState .

sdo:DeviceNodeShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdo:nodeId ],
        [ sh:class sdo:AdapterState ;
            sh:minCount 1 ;
            sh:path sdo:sourceAdapter ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path sdo:trustState ] ;
    sh:targetClass sdo:DeviceNode .

sdo:EvidenceReceiptShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdo:receiptId ],
        [ sh:class sdo:OrchestrationEvent ;
            sh:minCount 1 ;
            sh:path sdo:relatedEvent ],
        [ sh:class sdo:DeviceNode ;
            sh:minCount 1 ;
            sh:path sdo:subjectNode ],
        [ sh:class sdo:AdapterState ;
            sh:minCount 1 ;
            sh:path sdo:sourceAdapter ],
        [ sh:in ( "allowed" "denied" "requires_approval" "requires_local_only" "redacted" "degraded" ) ;
            sh:minCount 1 ;
            sh:path sdo:policyOutcome ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path sdo:retentionClass ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path sdo:redactionClass ] ;
    sh:targetClass sdo:EvidenceReceipt .

sdo:PolicyDecisionShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path sdo:capabilityClass ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdo:decisionId ],
        [ sh:in ( "allowed" "denied" "requires_approval" "requires_local_only" "redacted" "degraded" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdo:policyOutcome ] ;
    sh:targetClass sdo:PolicyDecision .

sdo:RoutineShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdo:routineId ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path sdo:capabilityClass ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path sdo:signature ] ;
    sh:targetClass sdo:Routine .

view:AgentAuthorityShape a sh:NodeShape ;
    sh:message "AgentAuthority must carry at least one authorityRef to Agent Registry state." ;
    sh:property [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path view:authorityRef ] ;
    sh:targetClass view:AgentAuthority .

view:PolicyAuthorityShape a sh:NodeShape ;
    sh:message "PolicyAuthority must carry at least one authorityRef to Policy Fabric decision or bundle state." ;
    sh:property [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path view:authorityRef ] ;
    sh:targetClass view:PolicyAuthority .

view:PrincipalAuthorityShape a sh:NodeShape ;
    sh:message "PrincipalAuthority must carry at least one authorityRef to a platform, Regis, or identity proof object." ;
    sh:property [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path view:authorityRef ] ;
    sh:targetClass view:PrincipalAuthority .

view:RevocationEpochShape a sh:NodeShape ;
    sh:message "RevocationEpoch must carry a non-negative integer revocationEpochValue." ;
    sh:property [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minInclusive 0 ;
            sh:path view:revocationEpochValue ] ;
    sh:targetClass view:RevocationEpoch .

view:RuntimeEvidenceAuthorityShape a sh:NodeShape ;
    sh:message "RuntimeEvidenceAuthority must preserve at least one AgentPlane or policy-verdict authority ref." ;
    sh:property [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path view:authorityRef ] ;
    sh:targetClass view:RuntimeEvidenceAuthority .

view:TraversalEvidenceAuthorityShape a sh:NodeShape ;
    sh:message "TraversalEvidenceAuthority must preserve at least one CairnPath authority ref." ;
    sh:property [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path view:authorityRef ] ;
    sh:targetClass view:TraversalEvidenceAuthority .

view:TypedAbsenceShape a sh:NodeShape ;
    sh:message "TypedAbsence must declare an allowed absence reason." ;
    sh:property [ sh:datatype xsd:string ;
            sh:in ( "not_authorized" "not_materialized" "redacted_by_policy" "revoked" "unknown" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path view:absenceReason ] ;
    sh:targetClass view:TypedAbsence .

view:ViewContractShape a sh:NodeShape ;
    sh:message "A ViewContract must bind principal, policy, workspace, disclosure, revocation epoch, and view signature authority roots." ;
    sh:property [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path view:hasPrincipalAuthority ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path view:hasPolicyAuthority ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path view:hasWorkspaceAuthority ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path view:hasDisclosureMode ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path view:hasRevocationEpoch ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path view:hasViewSignature ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path view:contractHash ;
            sh:pattern "^sha256:[A-Fa-f0-9]{64}$" ] ;
    sh:targetClass view:ViewContract .

view:ViewSignatureShape a sh:NodeShape ;
    sh:message "ViewSignature must carry a sha256 viewSignatureHash." ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path view:viewSignatureHash ;
            sh:pattern "^sha256:[A-Fa-f0-9]{64}$" ] ;
    sh:targetClass view:ViewSignature .

view:WorkspaceAuthorityShape a sh:NodeShape ;
    sh:message "WorkspaceAuthority must carry workspace/environment fingerprint authority refs." ;
    sh:property [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path view:authorityRef ] ;
    sh:targetClass view:WorkspaceAuthority .

capd:CapabilityShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path prop:descriptorId ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path prop:semver ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path prop:declaresPlane ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path prop:declaresVerb ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path prop:rolloutStrategy ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path prop:gateName ] ;
    sh:targetClass prop:CapabilityDescriptor .

