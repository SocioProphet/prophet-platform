            sh:path nl:integrator ],
        [ sh:minCount 1 ;
            sh:path nl:hasCharge ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path nl:forLayer ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path nl:algebra ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path nl:group ] ;
    sh:targetClass nl:LayerContract .

nl:OctonionWitnessRule a sh:NodeShape ;
    sh:rule [ a sh:SPARQLRule ;
            sh:construct """
      PREFIX nl: <https://socioprophet.github.io/ontogenesis/noether#>
      PREFIX sh: <http://www.w3.org/ns/shacl#>
      PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
      CONSTRUCT {
        ?this sh:result [
          a sh:ValidationResult ;
          sh:resultSeverity sh:Violation ;
          sh:resultMessage "Octonion contracts must record a coercion witness associator norm." ;
          sh:focusNode ?this ;
        ] .
      }
      WHERE {
        ?this nl:algebra nl:O .
        FILTER NOT EXISTS {
          ?this (nl:coercionIn|nl:coercionOut) ?c .
          ?c nl:hasWitness ?w .
          ?w nl:associatorNorm ?n .
        }
      }
    """ ] ;
    sh:targetClass nl:LayerContract .

