        [ sh:class iw:Workroom ;
            sh:minCount 1 ;
            sh:path iw:belongsToWorkroom ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path iw:status ] ;
    sh:targetClass iw:WorkOrder .

inv:ChainOfCustodyEventShape a sh:NodeShape ;
    sh:property [ sh:message "A custody event must declare the party holding custody." ;
