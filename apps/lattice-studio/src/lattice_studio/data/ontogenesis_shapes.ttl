<https://socioprophet.github.io/ontogenesis/shapes/smart-home-privacy.shacl.ttl> a sh:NodeShape ;
    rdfs:label "Smart home privacy SHACL bundle" .

systema:ConceptDefinitionShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path systema:definitionText ],
        [ sh:in ( "historical_source_claim" "operational_definition" "design_analogy" "formal_claim" "implementation_requirement" "conformance_rule" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path systema:claimLevel ] ;
    sh:targetClass systema:ConceptDefinition .

systema:EvidenceRequirementShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path systema:evidenceRequirementText ] ;
    sh:targetClass systema:EvidenceRequirement .

systema:ImplementationSurfaceShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path systema:ownerRepo ],
        [ sh:datatype xsd:string ;
            sh:path systema:surfacePath ] ;
    sh:targetClass systema:ImplementationSurface .

systema:SourceAnchorShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path systema:sourceRef ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path systema:sourceKind ],
        [ sh:in ( "A" "B" "C" "D" "E" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path systema:extractionConfidence ],
        [ sh:in ( "unreviewed" "candidate" "manually_reviewed" "independently_verified" "rejected" "contested" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path systema:reviewState ],
        [ sh:in ( "exact" "near_verbatim" "paraphrase" "operational_translation" "analogy" "unsupported" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path systema:quoteBoundary ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path systema:uncertaintyNote ] ;
    sh:targetClass systema:SourceAnchor .

systema:SystemaConceptEntryShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path systema:conceptId ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path systema:allowedUse ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path systema:forbiddenUse ],
        [ sh:class systema:ImplementationSurface ;
            sh:minCount 1 ;
            sh:path systema:implementationSurface ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path skos:prefLabel ],
        [ sh:class systema:EvidenceRequirement ;
            sh:minCount 1 ;
            sh:path systema:evidenceRequirement ],
        [ sh:class systema:SourceAnchor ;
            sh:minCount 1 ;
            sh:path systema:sourceAnchor ],
        [ sh:class systema:ConceptDefinition ;
            sh:minCount 1 ;
            sh:path systema:definition ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path systema:operationalDefinition ],
        [ sh:in ( "observed_term" "extracted_candidate" "source_anchored" "reviewed_definition" "operational_definition" "implementation_linked" "tested_doctrine" "public_standard" "deprecated" "contested" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path systema:promotionState ] ;
    sh:targetClass systema:SystemaConceptEntry .

ms:BeliefStateShape a sh:NodeShape ;
    sh:message "Belief states must declare truth status, methodology snapshot, and observation provenance." ;
    sh:property [ sh:minCount 1 ;
            sh:path ms:truthStatus ],
        [ sh:minCount 1 ;
            sh:path ms:usesMethodologySnapshot ],
        [ sh:minCount 1 ;
            sh:path ms:derivedFromObservation ] ;
    sh:targetClass ms:BeliefState .

ms:EquationCandidateShape a sh:NodeShape ;
    sh:message "Equation candidates must declare the proposed equation and methodology snapshot, with optional counterexamples and constraint witnesses." ;
    sh:property [ sh:minCount 1 ;
            sh:path ms:proposesEquation ],
        [ sh:minCount 1 ;
            sh:path ms:usesMethodologySnapshot ],
        [ sh:minCount 0 ;
            sh:path ms:hasCounterexample ],
        [ sh:minCount 0 ;
            sh:path ms:hasConstraintWitness ] ;
    sh:targetClass ms:EquationCandidate .

twin:HumanDigitalTwinShape a sh:NodeShape ;
    sh:message "Human digital twins must be anchored to a subject and bounded by consent, projection, memory, and cognition subsystems." ;
    sh:property [ sh:minCount 1 ;
            sh:path twin:anchorsSubject ],
        [ sh:minCount 1 ;
            sh:path twin:hasConsentEnvelope ],
        [ sh:minCount 1 ;
            sh:path twin:hasProjectionBound ],
        [ sh:minCount 1 ;
            sh:path twin:hasMemorySubsystem ],
        [ sh:minCount 1 ;
            sh:path twin:hasCognitionSubsystem ] ;
    sh:targetClass twin:HumanDigitalTwin .

