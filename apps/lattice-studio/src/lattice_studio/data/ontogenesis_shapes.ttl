            sh:path inv:evidenceIdentifier ],
        [ sh:class inv:ChainOfCustodyEvent ;
            sh:message "An evidence item must include at least one custody event." ;
            sh:minCount 1 ;
            sh:path inv:hasCustodyEvent ] ;
    sh:targetClass inv:EvidenceItem .

kcc:AlignmentEdgeShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:maxInclusive 1.0 ;
            sh:message "An alignment edge must preserve a normalized cosine in [0,1]." ;
            sh:minCount 1 ;
            sh:minInclusive 0.0 ;
            sh:path kcc:cosine ],
        [ sh:class kcc:Topic ;
            sh:message "An alignment edge must reference its canon topic." ;
            sh:minCount 1 ;
            sh:path kcc:alignsTopic ],
        [ sh:class kcc:TestSubject ;
            sh:message "An alignment edge must reference its test subject." ;
            sh:minCount 1 ;
            sh:path kcc:alignsSubject ] ;
    sh:targetClass kcc:AlignmentEdge .

kcc:DerivedAssertionShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:in ( "induced" "deduced" "abduced" ) ;
            sh:maxCount 1 ;
            sh:message "A derived assertion must declare exactly one epistemic mode: induced | deduced | abduced." ;
            sh:minCount 1 ;
            sh:path kcc:epistemicMode ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "A derived assertion must declare exactly one relation." ;
            sh:minCount 1 ;
            sh:path kcc:inducedRelation ],
        [ sh:datatype xsd:string ;
            sh:message "A derived assertion must name its subject." ;
            sh:minCount 1 ;
            sh:path kcc:inducedSubjectLabel ],
        [ sh:datatype xsd:string ;
            sh:message "A derived assertion must name its object." ;
            sh:minCount 1 ;
            sh:path kcc:inducedObjectLabel ],
        [ sh:message "A derived assertion must declare its provenance (dct:source)." ;
            sh:minCount 1 ;
            sh:path dct:source ] ;
    sh:targetClass kcc:DerivedAssertion .

kcc:FormulaShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:message "A canon formula must declare its statement (form)." ;
            sh:minCount 1 ;
            sh:path math:hasStatement ],
        [ sh:class kcc:Topic ;
            sh:message "A canon formula must be attached to a topic." ;
            sh:minCount 1 ;
            sh:path dct:subject ] ;
    sh:targetClass kcc:Formula .

kcc:GlossaryTermShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:message "A glossary term must declare a definition." ;
            sh:minCount 1 ;
            sh:path skos:definition ] ;
    sh:targetClass kcc:GlossaryTerm .

kcc:KnowledgeConceptShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:message "A canon concept must declare exactly one preferred label." ;
            sh:minCount 1 ;
            sh:path skos:prefLabel ],
        [ sh:class kc:KnowledgeContext ;
            sh:message "A canon concept must be bound to a governed Knowledge Context." ;
            sh:minCount 1 ;
            sh:path kcc:inKnowledgeContext ] ;
    sh:targetClass kcc:KnowledgeConcept .

kcc:TopicShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "A canon topic must declare exactly one level." ;
            sh:minCount 1 ;
            sh:path kcc:level ] ;
    sh:targetClass kcc:Topic .

legal:LegalEntityShape a sh:NodeShape ;
    sh:property [ sh:class legal:Jurisdiction ;
            sh:minCount 1 ;
            sh:path legal:incorporatedIn ],
        [ sh:class legal:Jurisdiction ;
            sh:minCount 1 ;
            sh:path legal:incorporatedIn ] ;
    sh:targetClass legal:LegalEntity .

legal:OwnershipRelationShape a sh:NodeShape ;
    sh:property [ sh:class legal:LegalEntity ;
            sh:minCount 1 ;
            sh:path legal:ownedByEntity ],
        [ sh:class legal:LegalEntity ;
            sh:minCount 1 ;
            sh:path legal:ownsEntity ],
        [ sh:class legal:LegalEntity ;
            sh:minCount 1 ;
            sh:path legal:ownedByEntity ],
        [ sh:class legal:LegalEntity ;
            sh:minCount 1 ;
            sh:path legal:ownsEntity ] ;
    sh:targetClass legal:OwnershipRelation .

legal:RepositoryAllocationShape a sh:NodeShape ;
    sh:property [ sh:class legal:RepositoryAsset ;
            sh:minCount 1 ;
            sh:path legal:allocatesRepository ],
        [ sh:class legal:LegalEntity ;
            sh:minCount 1 ;
            sh:path legal:allocatedToEntity ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path legal:allocationRuleText ],
        [ sh:class legal:RepositoryAsset ;
            sh:minCount 1 ;
            sh:path legal:allocatesRepository ],
        [ sh:class legal:LegalEntity ;
            sh:minCount 1 ;
            sh:path legal:allocatedToEntity ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path legal:allocationRuleText ] ;
    sh:targetClass legal:RepositoryAllocation .

party:PartyShape a sh:NodeShape ;
    sh:property [ sh:class party:IdentityRecord ;
            sh:minCount 1 ;
            sh:path party:hasIdentityRecord ],
        [ sh:class party:RoleAssignment ;
            sh:minCount 1 ;
            sh:path party:hasRoleAssignment ],
        [ sh:class party:IdentityRecord ;
            sh:minCount 1 ;
            sh:path party:hasIdentityRecord ],
        [ sh:class party:RoleAssignment ;
            sh:minCount 1 ;
            sh:path party:hasRoleAssignment ] ;
    sh:targetClass party:Party .

party:RoleAssignmentShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path party:roleName ],
        [ sh:class party:Party ;
            sh:minCount 1 ;
            sh:path party:roleHeldBy ],
        [ sh:class cs:CyberneticSelf ;
            sh:minCount 1 ;
            sh:path party:roleWithinSelf ],
        [ sh:class party:Party ;
            sh:minCount 1 ;
            sh:path party:roleHeldBy ],
        [ sh:class cs:CyberneticSelf ;
            sh:minCount 1 ;
            sh:path party:roleWithinSelf ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path party:roleName ] ;
    sh:targetClass party:RoleAssignment .

ps:CapabilityShape a sh:NodeShape ;
    sh:property [ sh:class ps:Feature ;
            sh:minCount 1 ;
            sh:path ps:includesFeature ],
        [ sh:class ps:Feature ;
            sh:minCount 1 ;
            sh:path ps:includesFeature ] ;
    sh:targetClass ps:Capability .

ps:OfferingShape a sh:NodeShape ;
    sh:property [ sh:class ps:Plan ;
            sh:minCount 1 ;
            sh:path ps:hasPlan ] ;
    sh:targetClass biz:Offering .

ps:PlanShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path ps:planCode ],
        [ sh:class ps:SKU ;
            sh:minCount 1 ;
            sh:path ps:soldAsSKU ],
        [ sh:class ps:Capability ;
            sh:minCount 1 ;
            sh:path ps:includesCapability ],
        [ sh:class party:Entitlement ;
            sh:minCount 1 ;
            sh:path ps:grantsEntitlement ],
        [ sh:class ps:ServiceLevel ;
            sh:minCount 1 ;
            sh:path ps:defaultSLA ],
        [ sh:class ps:PriceBook ;
            sh:minCount 1 ;
            sh:path ps:pricedInBook ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path ps:planCode ],
        [ sh:class ps:SKU ;
            sh:minCount 1 ;
            sh:path ps:soldAsSKU ],
        [ sh:class ps:Capability ;
            sh:minCount 1 ;
            sh:path ps:includesCapability ],
        [ sh:class party:Entitlement ;
            sh:minCount 1 ;
            sh:path ps:grantsEntitlement ],
        [ sh:class ps:ServiceLevel ;
            sh:minCount 1 ;
            sh:path ps:defaultSLA ],
        [ sh:class ps:PriceBook ;
            sh:minCount 1 ;
            sh:path ps:pricedInBook ] ;
    sh:targetClass ps:Plan .

ps:ProductOfferingShape a sh:NodeShape ;
    sh:property [ sh:class ps:Plan ;
            sh:minCount 1 ;
            sh:path ps:hasPlan ],
        [ sh:class ps:Plan ;
            sh:minCount 1 ;
            sh:path ps:hasPlan ] ;
    sh:targetClass ps:ProductOffering .

ps:ServiceInstanceShape a sh:NodeShape ;
    sh:property [ sh:class ps:Plan ;
            sh:minCount 1 ;
            sh:path ps:instantiatesPlan ],
        [ sh:class party:Party ;
            sh:minCount 1 ;
            sh:path ps:provisionedFor ],
        [ sh:class legal:LegalEntity ;
            sh:minCount 1 ;
            sh:path ps:governedByProvider ],
        [ sh:class biz:Contract ;
            sh:minCount 1 ;
            sh:path ps:billedUnderContract ],
        [ sh:class ps:Plan ;
            sh:minCount 1 ;
            sh:path ps:instantiatesPlan ],
        [ sh:class party:Party ;
            sh:minCount 1 ;
            sh:path ps:provisionedFor ],
        [ sh:class legal:LegalEntity ;
            sh:minCount 1 ;
            sh:path ps:governedByProvider ],
        [ sh:class biz:Contract ;
            sh:minCount 1 ;
            sh:path ps:billedUnderContract ] ;
    sh:targetClass ps:ServiceInstance .

ps:ServiceOfferingShape a sh:NodeShape ;
    sh:property [ sh:class ps:Plan ;
            sh:minCount 1 ;
            sh:path ps:hasPlan ],
        [ sh:class ps:Plan ;
            sh:minCount 1 ;
            sh:path ps:hasPlan ] ;
    sh:targetClass ps:ServiceOffering .

st:PackageProvenanceShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "PackageProvenance must include a source reference." ;
            sh:minCount 1 ;
            sh:path st:sourceRef ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "PackageProvenance must include package path." ;
            sh:minCount 1 ;
            sh:path st:packagePath ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:message "PackageProvenance must include observation time." ;
            sh:minCount 1 ;
            sh:path st:observedAt ],
        [ sh:datatype xsd:string ;
            sh:in ( "extracted" "inferred" "reviewed" "rejected" ) ;
            sh:maxCount 1 ;
            sh:message "PackageProvenance claimLevel must be one of extracted, inferred, reviewed, or rejected." ;
            sh:minCount 1 ;
            sh:path st:claimLevel ] ;
    sh:targetClass st:PackageProvenance .

st:PhysicalDomainGateShape a sh:NodeShape ;
    sh:sparql [ sh:message "Physical-domain tools must require physical_domain_authorization." ;
            sh:select """
      PREFIX st: <https://socioprophet.github.io/ontogenesis/domains/security-tools#>
      SELECT $this WHERE {
        $this st:hasRiskSignal ?risk .
        ?risk st:physicalDomain true .
        FILTER NOT EXISTS { $this st:requiresGate "physical_domain_authorization" }
      }
    """ ] ;
    sh:targetClass st:SecurityTool .

st:RestrictedCatalogOnlyShape a sh:NodeShape ;
    sh:sparql [ sh:message "RestrictedCatalogOnly, BlockedRuntime, and UnknownReviewRequired tools cannot default to ReadOnly or SandboxedLab." ;
            sh:select """
      PREFIX st: <https://socioprophet.github.io/ontogenesis/domains/security-tools#>
      SELECT $this WHERE {
        $this st:hasSafetyClass ?safety ;
              st:defaultExecutionMode ?mode .
        FILTER (?safety IN (st:RestrictedCatalogOnly, st:BlockedRuntime, st:UnknownReviewRequired))
        FILTER (?mode IN (st:ReadOnly, st:SandboxedLab))
      }
    """ ] ;
    sh:targetSubjectsOf st:hasSafetyClass .

st:SecurityToolShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "SecurityTool must have exactly one stable tool ID." ;
            sh:minCount 1 ;
            sh:path st:toolId ;
            sh:pattern "^tool-[A-Za-z0-9._:-]+$" ],
        [ sh:class st:PackageProvenance ;
            sh:maxCount 1 ;
            sh:message "SecurityTool must retain package provenance." ;
            sh:minCount 1 ;
            sh:path st:hasPackageProvenance ],
        [ sh:datatype xsd:boolean ;
            sh:hasValue true ;
            sh:maxCount 1 ;
            sh:message "SecurityTool imports must require a wrapper before any future execution path." ;
            sh:minCount 1 ;
            sh:path st:wrapperRequired ],
        [ sh:datatype xsd:boolean ;
            sh:hasValue false ;
            sh:maxCount 1 ;
            sh:message "SecurityTool imports must not allow production execution." ;
            sh:minCount 1 ;
            sh:path st:productionAllowed ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "SecurityTool must declare its source corpus." ;
            sh:minCount 1 ;
            sh:path st:sourceCorpus ],
        [ sh:datatype xsd:string ;
            sh:message "SecurityTool must retain at least one source category." ;
            sh:minCount 1 ;
            sh:path st:category ],
        [ sh:class st:SecurityCapability ;
            sh:message "SecurityTool must map to at least one normalized SecurityCapability." ;
            sh:minCount 1 ;
            sh:path st:hasCapability ],
        [ sh:class st:SafetyClass ;
            sh:maxCount 1 ;
            sh:message "SecurityTool must have exactly one SafetyClass." ;
            sh:minCount 1 ;
            sh:path st:hasSafetyClass ],
        [ sh:class st:ExecutionMode ;
            sh:message "SecurityTool must declare at least one permitted descriptive ExecutionMode." ;
            sh:minCount 1 ;
            sh:path st:hasExecutionMode ],
        [ sh:class st:ExecutionMode ;
            sh:maxCount 1 ;
            sh:message "SecurityTool must have exactly one default ExecutionMode." ;
            sh:minCount 1 ;
            sh:path st:defaultExecutionMode ],
        [ sh:class st:ToolRiskSignal ;
            sh:maxCount 1 ;
            sh:message "SecurityTool must have one ToolRiskSignal node." ;
            sh:minCount 1 ;
            sh:path st:hasRiskSignal ],
        [ sh:class st:ToolEvidenceContract ;
            sh:maxCount 1 ;
            sh:message "SecurityTool must have one ToolEvidenceContract." ;
            sh:minCount 1 ;
            sh:path st:hasEvidenceContract ] ;
    sh:targetClass st:SecurityTool .

