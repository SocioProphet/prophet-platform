<https://socioprophet.github.io/ontogenesis/shapes/business_drivers.shacl.ttl> a sh:NodeShape ;
    sh:message "Business driver edges must declare fromMetric, toMetric, sign, relationType, lagValue, lagUnit, and confidence." ;
    sh:property [ sh:class bizm:MetricConcept ;
            sh:minCount 1 ;
            sh:path bizd:fromMetric ],
        [ sh:class bizm:MetricConcept ;
            sh:minCount 1 ;
            sh:path bizd:toMetric ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path bizd:sign ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path bizd:relationType ],
        [ sh:datatype xsd:decimal ;
            sh:minCount 1 ;
            sh:path bizd:lagValue ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path bizd:lagUnit ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path bizd:confidence ] ;
    sh:targetClass bizd:DriverEdge .

<https://socioprophet.github.io/ontogenesis/shapes/business_metrics.shacl.ttl> a sh:NodeShape ;
    sh:message "Business metric concepts must declare unitFamily, grainFamily, timeBehavior, and scopeFamily." ;
    sh:property [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path bizm:unitFamily ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path bizm:grainFamily ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path bizm:timeBehavior ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path bizm:scopeFamily ] ;
    sh:targetClass bizm:MetricConcept .

