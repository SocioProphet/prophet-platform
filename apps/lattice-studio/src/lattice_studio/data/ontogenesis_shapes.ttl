            sh:path inv:custodyTimestamp ] ;
    sh:targetClass inv:ChainOfCustodyEvent .

inv:EvidenceItemShape a sh:NodeShape ;
    sh:property [ sh:message "An evidence item must declare an evidence identifier." ;
            sh:minCount 1 ;
