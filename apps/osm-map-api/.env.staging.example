# OSM Map API — staging / demo environment configuration example
#
# Copy this file, fill in real paths and origins, and source it before
# running `python3 -m osm_map_api`, or pass equivalent values to your
# container/service orchestrator.
#
# Do NOT commit a populated copy of this file.  Treat fixture roots and
# allowed origins as operator-specific deployment config.

# ---------------------------------------------------------------------------
# Fixture roots (required)
# ---------------------------------------------------------------------------
# Point each variable at the checked-out or mounted repo root that supplies
# the fixture files the API reads.  All three must exist for /readyz to pass.

GAIA_FIXTURE_ROOT=/mnt/fixtures/gaia-world-model
SHERLOCK_FIXTURE_ROOT=/mnt/fixtures/sherlock-search
SOCIOSPHERE_FIXTURE_ROOT=/mnt/fixtures/sociosphere

# ---------------------------------------------------------------------------
# Server bind (optional — defaults shown)
# ---------------------------------------------------------------------------
# Bind to 0.0.0.0 when running inside a container that exposes port 8088.
# Leave as 127.0.0.1 for local development behind a same-host proxy.

OSM_MAP_API_HOST=0.0.0.0
OSM_MAP_API_PORT=8088

# ---------------------------------------------------------------------------
# CORS (required for direct browser access; omit when using a same-origin
# reverse-proxy that forwards /api/* to this service)
# ---------------------------------------------------------------------------
# List only the exact browser origins that may call this API.
# Multiple origins are comma-separated.  Never use *.

OSM_MAP_API_CORS_ALLOWED_ORIGINS=https://staging.your-app.example

# Set to true only if the browser must send credentials (cookies / auth
# headers) and the origin above matches exactly.

OSM_MAP_API_CORS_ALLOW_CREDENTIALS=false

# ---------------------------------------------------------------------------
# Vue / Vite client side (.env.staging in the Vue app)
# ---------------------------------------------------------------------------
# The Vue shell reads VITE_GAIA_MAP_API_BASE to locate this service.
#
# Option A — direct API URL (requires OSM_MAP_API_CORS_ALLOWED_ORIGINS above):
#   VITE_GAIA_MAP_API_BASE=https://api-staging.your-app.example
#
# Option B — same-origin reverse-proxy path (no extra CORS config needed):
#   VITE_GAIA_MAP_API_BASE=/api
#
# The Vue shell falls back to deterministic demo data when this API is
# unreachable.  Treat /readyz != ready as a backend issue to resolve;
# the fallback is for product demonstration only, not production readiness.
