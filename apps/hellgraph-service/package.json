{
  "name": "@socioprophet/hellgraph-service",
  "version": "0.1.0",
  "private": true,
  "description": "Node/TS microservice exposing the shared HellGraph AtomSpace engine (@socioprophet/hellgraph) over HTTP so Go/Python/browser services in prophet-platform can use it.",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/*.test.ts",
    "check:engine": "node scripts/check-engine-version.mjs"
  },
  "dependencies": {
    "@socioprophet/hellgraph": "file:vendor/socioprophet-hellgraph-0.4.3.tgz"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0"
  },
  "optionalDependencies": {
    "autobase": "7.28.1",
    "corestore": "7.11.0",
    "hyperswarm": "4.17.0"
  }
}
