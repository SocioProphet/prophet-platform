        "verdict": "ZERO"
      },
      {
        "law": "POS",
        "evidence": "POS",
        "verdict": "POS"
      }
    ],
    "mustNotHold": [
      {
        "law": "NEG",
        "evidence": "NEG",
        "verdict": "POS",
        "why": "the sign-multiplication trap: a refused gate and a refuted outcome cannot certify as true"
      }
    ]
  },
  "lawFactor": [
    {
      "barCleared": true,
      "residual": [],
      "expect": "POS",
      "why": "cleared clean"
    },
    {
