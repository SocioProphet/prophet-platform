{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://socioprophet.dev/schemas/workspace-control-plane/catalog-entry.v0.schema.json",
  "title": "catalog-entry.v0",
  "description": "A SIGNED trust-catalog entry (spec D9), TUF-role shaped: root/targets/snapshot/timestamp with delegation threshold, expiry, and multiple signatures.",
  "type": "object",
  "additionalProperties": false,
  "required": ["entry_id", "role", "version", "targets", "expiry", "signatures"],
  "properties": {
    "entry_id": { "type": "string", "minLength": 8 },
    "role": { "enum": ["root", "targets", "snapshot", "timestamp"] },
    "version": { "type": "integer", "minimum": 1 },
    "targets": { "type": "array", "items": { "type": "string" } },
    "expiry": { "type": "string" },
    "delegation": {
      "type": "object", "additionalProperties": false,
      "properties": { "threshold": { "type": "integer", "minimum": 1 }, "keys": { "type": "array", "items": { "type": "string" } } }
    },
    "signatures": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["signer", "algorithm", "signature", "signed_at"],
        "properties": {
          "signer": { "type": "string" },
          "algorithm": { "enum": ["ed25519", "ecdsa-p256", "sigstore-keyless", "hmac-sha256"] },
          "signature": { "type": "string" },
          "cert_ref": { "type": "string" },
          "signed_at": { "type": "string" }
        }
      }
    }
  }
}
