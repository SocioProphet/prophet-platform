{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://socioprophet.dev/schemas/workspace-control-plane/topic-manifest.v0.schema.json",
  "title": "topic-manifest.v0",
  "description": "A SIGNED data-topic manifest (spec D8/D9). A data topic is NOT a callable capability; kept in a separate plane. Names the overlay transport for the topic.",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_id", "kind", "topic", "transport", "expiry", "signature"],
  "properties": {
    "manifest_id": { "type": "string", "minLength": 8 },
    "kind": { "const": "data_topic" },
    "topic": { "type": "string" },
    "transport": { "enum": ["hypercore", "hyperswarm", "autobase", "hyperdrive"] },
    "discovery_key": { "type": "string" },
    "expiry": { "type": "string" },
    "revocation": {
      "type": "object", "additionalProperties": false,
      "required": ["revoked"],
      "properties": { "revoked": { "type": "boolean" }, "reason": { "type": "string" } }
    },
    "signature": { "type": "object", "additionalProperties": false, "required": ["signer", "algorithm", "signature", "signed_at"], "properties": { "signer": { "type": "string" }, "algorithm": { "enum": ["ed25519", "ecdsa-p256", "sigstore-keyless"] }, "signature": { "type": "string" }, "cert_ref": { "type": "string" }, "signed_at": { "type": "string" } } }
  }
}
