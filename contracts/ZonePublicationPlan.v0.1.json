{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ZonePublicationPlan v0.1",
  "type": "object",
  "required": [
    "ok",
    "zone_ref",
    "event_type",
    "topic",
    "publication_mode",
    "carrier_ref",
    "event_ref",
    "receipt_ref",
    "catalog_ref"
  ],
  "properties": {
    "ok": {
      "type": "boolean"
    },
    "version": {
      "type": "string"
    },
    "zone_ref": {
      "type": "string"
    },
    "event_type": {
      "type": "string"
    },
    "topic": {
      "type": "string"
    },
    "topic_ref": {
      "type": "string"
    },
    "publication_mode": {
      "type": "string",
      "enum": [
        "explicit",
        "resolved"
      ]
    },
    "carrier_ref": {
      "type": "string"
    },
    "event_ref": {
      "type": "string"
    },
    "receipt_ref": {
      "type": "string"
    },
    "catalog_ref": {
      "type": "string"
    }
  }
}
