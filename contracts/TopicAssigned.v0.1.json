{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://socioprophet.org/contracts/TopicAssigned.v0.1.json",
  "title": "TopicAssigned",
  "type": "object",
  "required": [
    "version",
    "event_id",
    "created_at",
    "carrier_ref",
    "slash_topics_pack_ref",
    "membrane_decision_ref",
    "topics",
    "receipt"
  ],
  "properties": {
    "version": { "const": "0.1" },
    "event_id": { "type": "string" },
    "created_at": { "type": "string" },
    "carrier_ref": {
      "type": "string",
      "description": "Reference/hash to the ingested carrier artifact."
    },
    "slash_topics_pack_ref": {
      "type": "string",
      "description": "Reference/hash to the topic pack used."
    },
    "membrane_decision_ref": {
      "type": "string",
      "description": "Reference/hash to the MembraneDecision artifact that allowed or denied and scoped the action."
    },
    "topics": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "receipt": {
      "type": "object",
      "required": ["hash", "algo"],
      "properties": {
        "hash": { "type": "string" },
        "algo": { "type": "string", "enum": ["sha256", "blake3"] }
      }
    }
  }
}
