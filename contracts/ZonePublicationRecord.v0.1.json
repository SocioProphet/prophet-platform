{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ZonePublicationRecord v0.1",
  "type": "object",
  "required": [
    "version",
    "publication_id",
    "created_at",
    "service_ref",
    "status",
    "zone_ref",
    "event_type",
    "topic",
    "publication_mode",
    "carrier_ref",
    "event_ref",
    "receipt_ref",
    "catalog_ref"
  ],
  "properties": {
    "version": {"type": "string"},
    "publication_id": {"type": "string"},
    "created_at": {"type": "string"},
    "service_ref": {"type": "string"},
    "status": {"type": "string", "enum": ["planned", "published", "failed"]},
    "zone_ref": {"type": "string"},
    "event_type": {"type": "string"},
    "topic": {"type": "string"},
    "topic_ref": {"type": "string"},
    "publication_mode": {"type": "string", "enum": ["explicit", "resolved"]},
    "carrier_ref": {"type": "string"},
    "event_ref": {"type": "string"},
    "receipt_ref": {"type": "string"},
    "catalog_ref": {"type": "string"}
  }
}
