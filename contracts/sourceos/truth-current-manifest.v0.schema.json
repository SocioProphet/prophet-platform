{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.socioprophet.ai/sourceos/truth-current-manifest.v0.schema.json",
  "title": "SourceOS TruthCurrentManifest v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "id", "generated_at", "subject", "current", "truth_plane", "integrity", "status"],
  "properties": {
    "schema_version": { "const": "sourceos.truth-current-manifest/v0" },
    "kind": { "const": "SourceOSTruthCurrentManifest" },
    "id": { "type": "string", "pattern": "^stm-[a-z0-9][a-z0-9._-]{5,127}$" },
    "generated_at": { "type": "string", "format": "date-time" },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_kind", "subject_id"],
      "properties": {
        "subject_kind": { "type": "string", "enum": ["device", "node", "workspace", "fixture"] },
        "subject_id": { "type": "string", "minLength": 1 },
        "device_claim": { "type": "string" }
      }
    },
    "current": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release_set_ref", "boot_release_set_ref", "fingerprint_ref", "compliance_result_ref", "proof_index_ref"],
      "properties": {
        "release_set_ref": { "type": "string", "minLength": 1 },
        "boot_release_set_ref": { "type": "string", "minLength": 1 },
        "fingerprint_ref": { "type": "string", "minLength": 1 },
        "compliance_result_ref": { "type": "string", "minLength": 1 },
        "proof_index_ref": { "type": "string", "minLength": 1 },
        "previous_boot_receipt_ref": { "type": "string" },
        "current_boot_receipt_ref": { "type": "string" }
      }
    },
    "truth_plane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["service_shape", "endpoints"],
      "properties": {
        "service_shape": { "type": "string", "enum": ["fixture", "http", "grpc", "tritrpc"] },
        "endpoints": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "method", "path", "returns"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "method": { "type": "string", "enum": ["GET", "POST", "TRITRPC"] },
              "path": { "type": "string", "minLength": 1 },
              "returns": { "type": "string", "minLength": 1 },
              "notes": { "type": "string" }
            }
          }
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hash_algorithm", "object_digests", "signature_state", "crypto_profile"],
      "properties": {
        "hash_algorithm": { "type": "string", "enum": ["sha256"] },
        "object_digests": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["object_ref", "path", "digest"],
            "properties": {
              "object_ref": { "type": "string", "minLength": 1 },
              "path": { "type": "string", "minLength": 1 },
              "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
            }
          }
        },
        "signature_state": { "type": "string", "enum": ["unsigned_fixture", "signed", "signature_shape_validated"] },
        "signature_ref": { "type": "string" },
        "crypto_profile": { "type": "string", "enum": ["standard", "fips-140-3-compatible"] }
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compliance", "agentplane_eligible", "gaia_ingest_eligible", "sherlock_evidence_eligible"],
      "properties": {
        "compliance": { "type": "string", "enum": ["compliant", "drifted", "unknown", "failed"] },
        "agentplane_eligible": { "type": "boolean" },
        "gaia_ingest_eligible": { "type": "boolean" },
        "sherlock_evidence_eligible": { "type": "boolean" },
        "reasons": { "type": "array", "items": { "type": "string" } }
      }
    },
    "notes": { "type": "array", "items": { "type": "string" } }
  }
}
