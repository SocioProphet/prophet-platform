{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.socioprophet.ai/sourceos/proof-index.v0.schema.json",
  "title": "SourceOS ProofIndex v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "id",
    "created_at",
    "subject",
    "release_set_ref",
    "entries",
    "root_digest"
  ],
  "properties": {
    "schema_version": { "const": "sourceos.proof-index/v0" },
    "kind": { "const": "SourceOSProofIndex" },
    "id": { "type": "string", "pattern": "^spi-[a-z0-9][a-z0-9._-]{5,127}$" },
    "created_at": { "type": "string", "format": "date-time" },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_kind", "subject_id"],
      "properties": {
        "subject_kind": { "type": "string", "enum": ["device", "user_workspace", "agent_workspace", "boot_environment", "release"] },
        "subject_id": { "type": "string", "minLength": 1 }
      }
    },
    "release_set_ref": { "type": "string", "minLength": 1 },
    "boot_release_set_ref": { "type": "string" },
    "config_source_refs": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "ref", "digest"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "release_set",
              "boot_release_set",
              "config_source",
              "fingerprint",
              "compliance_result",
              "bom",
              "sbom",
              "signature",
              "build_log",
              "audit_log",
              "other"
            ]
          },
          "ref": { "type": "string", "minLength": 1 },
          "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "required": { "type": "boolean" }
        }
      }
    },
    "root_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "signatures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key_id", "algorithm", "signature_ref"],
        "properties": {
          "key_id": { "type": "string", "minLength": 1 },
          "algorithm": { "type": "string", "enum": ["ed25519", "sigstore", "gpg", "x509"] },
          "signature_ref": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
