{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RemediationPlan",
  "description": "A structured plan for remediating an identified incident or divergence. High-risk actions must reference an ActionGrant.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "investigation_id", "created_at", "created_by", "steps"],
  "properties": {
    "schema_version": { "const": "0.1" },
    "plan_id": { "type": "string", "minLength": 1 },
    "investigation_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "created_by": { "type": "string", "minLength": 1 },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step_id", "description", "risk_level"],
        "properties": {
          "step_id": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "risk_level": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
          "action_grant_ref": { "type": "string" },
          "status": { "type": "string", "enum": ["pending", "in_progress", "completed", "blocked", "skipped"] }
        }
      }
    },
    "regression_fixture_ref": { "type": "string" },
    "approved_by": { "type": "string" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "steps": {
            "contains": {
              "properties": { "risk_level": { "enum": ["high", "critical"] } }
            }
          }
        }
      },
      "then": {
        "properties": {
          "steps": {
            "items": {
              "if": { "properties": { "risk_level": { "enum": ["high", "critical"] } } },
              "then": { "required": ["action_grant_ref"] }
            }
          }
        }
      }
    }
  ]
}
