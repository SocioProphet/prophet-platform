{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://socioprophet.com/schemas/release/fogstack-registry-root-metadata-v0.1.schema.json",
  "title": "FogStackRegistryRootMetadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schema_version", "registry_uri", "releases", "signed"],
  "properties": {
    "kind": { "const": "FogStackRegistryRootMetadata" },
    "schema_version": { "const": "v0.1" },
    "registry_uri": { "type": "string", "minLength": 1 },
    "releases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "bundle_id",
          "version",
          "release_pointer_ref",
          "release_pointer_digest",
          "registry_publication_index_ref",
          "registry_publication_index_digest"
        ],
        "properties": {
          "bundle_id": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "release_pointer_ref": { "type": "string", "minLength": 1 },
          "release_pointer_digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "registry_publication_index_ref": { "type": "string", "minLength": 1 },
          "registry_publication_index_digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        }
      }
    },
    "revocation_index_ref": { "type": ["string", "null"] },
    "revocation_index_digest": {
      "type": ["string", "null"],
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "signed": { "type": "boolean" },
    "signature": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "ref"],
          "properties": {
            "type": { "type": "string", "minLength": 1 },
            "ref": { "type": "string", "minLength": 1 }
          }
        }
      ]
    }
  }
}
