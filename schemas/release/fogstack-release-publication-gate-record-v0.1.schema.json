    "schema_version": { "const": "v0.1" },
    "publication_set_ref": { "type": "string" },
    "approval_record_ref": { "type": "string" },
    "approval_signature_verification_ref": { "type": "string" },
    "release_identity_ref": { "type": "string" },
    "status": { "enum": ["pass", "fail"] },
