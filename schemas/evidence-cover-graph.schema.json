{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.socioprophet.ai/prophet-platform/evidence-cover-graph.schema.json",
  "title": "Evidence Cover Graph",
  "description": "Registry of evidence sufficiency expressed as covers (hyperedges) over content-addressed evidence items, with overlap (gluing) constraints and disclosure tiers. Standards-layer artifact carried as an opaque typed payload; not a wire protocol. Operationalizes evidence-families-as-covers + admissibility-tiers + sheafification-as-repair.",
  "type": "object",
  "additionalProperties": false,
  "required": ["evidence_cover_graph_version", "claim_id", "evidence_items", "covers"],
  "properties": {
    "evidence_cover_graph_version": { "type": "integer", "enum": [1] },
    "claim_id": { "type": "string", "minLength": 1 },
    "evidence_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "digest_sha256"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "minLength": 1 },
          "digest_sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
          "scope_ref": { "type": "string" },
          "actor_ref": { "type": "string" },
          "ts_range": {
            "type": "object",
            "additionalProperties": false,
            "required": ["start_ms", "end_ms"],
            "properties": {
              "start_ms": { "type": "integer", "minimum": 0 },
              "end_ms": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "covers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cover_id", "claim_id", "tier", "evidence_item_ids"],
        "properties": {
          "cover_id": { "type": "string", "minLength": 1 },
          "claim_id": { "type": "string", "minLength": 1 },
          "tier": { "type": "string", "minLength": 1 },
          "evidence_item_ids": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          }
        }
      }
    },
    "overlap_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["overlap_id", "covers", "must_agree_on"],
        "properties": {
          "overlap_id": { "type": "string", "minLength": 1 },
          "covers": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "must_agree_on": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^[A-Za-z0-9_]+\\.[A-Za-z0-9_]+$" }
          }
        }
      }
    },
    "tier_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tier_order"],
      "properties": {
        "tier_order": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "admissibility_floor_by_claim_class": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    }
  }
}
