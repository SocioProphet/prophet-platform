{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.socioprophet.dev/prophet-platform/workspace-source-binding.v1.schema.json",
  "title": "WorkspaceSourceBinding v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "bindingId", "projectId", "userId", "notebookSessionId", "runtimeAssetId", "sourceIds", "policyRef", "evidenceCorrelationId", "createdAt"],
  "properties": {
    "apiVersion": {"const": "studio.socioprophet.dev/v1"},
    "kind": {"const": "WorkspaceSourceBinding"},
    "bindingId": {"type": "string", "pattern": "^workspace-binding:[a-fA-F0-9]{16}$"},
    "projectId": {"type": "string", "minLength": 1},
    "userId": {"type": "string", "minLength": 1},
    "notebookSessionId": {"type": "string", "pattern": "^notebook-session:[a-fA-F0-9]{16}$"},
    "runtimeAssetId": {"type": "string", "pattern": "^runtime-asset:[a-z0-9][a-z0-9.-]{1,62}:[v]?[0-9]+\\.[0-9]+\\.[0-9]+([-.+][A-Za-z0-9.-]+)?$"},
    "sourceIds": {
      "type": "array",
      "items": {"type": "string", "pattern": "^workspace-source:[a-z0-9][a-z0-9:._/@-]{1,160}$"},
      "minItems": 1,
      "uniqueItems": true
    },
    "policyRef": {"type": "string", "minLength": 1},
    "evidenceCorrelationId": {"type": "string", "minLength": 1},
    "createdAt": {"type": "string", "format": "date-time"}
  }
}
