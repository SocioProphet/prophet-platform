{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.socioprophet.ai/depo/minimum-depo.v1.json",
  "title": "SocioProphet Minimum DEPO Proof Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "proofId",
    "version",
    "generatedAt",
    "scope",
    "statusVocabulary",
    "repositories",
    "criteria",
    "artifacts",
    "demoCommands",
    "claims"
  ],
  "properties": {
    "proofId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.:-]+$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([-.+][A-Za-z0-9.-]+)?$"},
    "generatedAt": {"type": "string", "format": "date-time"},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question", "proves", "doesNotProve", "verticalSlice"],
      "properties": {
        "question": {"type": "string"},
        "proves": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "doesNotProve": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "verticalSlice": {"type": "array", "minItems": 3, "items": {"type": "string"}}
      }
    },
    "statusVocabulary": {
      "type": "array",
      "items": {"enum": ["live", "validated", "simulated", "record-only", "not-yet-wired", "not-yet-verified"]},
      "minItems": 6,
      "uniqueItems": true
    },
    "repositories": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repo", "role", "status", "evidenceClass"],
        "properties": {
          "repo": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
          "role": {"type": "string"},
          "status": {"enum": ["live", "validated", "simulated", "record-only", "not-yet-wired", "not-yet-verified"]},
          "evidenceClass": {"enum": ["Code/file-verified", "Schema/contract-verified", "Test/CI-verified", "Dossier-supported", "Architecturally inferred", "Not yet verified from reviewed repository contents"]}
        }
      }
    },
    "criteria": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "status", "evidenceClass", "passCondition", "evidenceRefs"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
          "description": {"type": "string"},
          "status": {"enum": ["live", "validated", "simulated", "record-only", "not-yet-wired", "not-yet-verified"]},
          "evidenceClass": {"enum": ["Code/file-verified", "Schema/contract-verified", "Test/CI-verified", "Dossier-supported", "Architecturally inferred", "Not yet verified from reviewed repository contents"]},
          "passCondition": {"type": "string"},
          "evidenceRefs": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path", "status"],
        "properties": {
          "kind": {"type": "string"},
          "path": {"type": "string"},
          "status": {"enum": ["live", "validated", "simulated", "record-only", "not-yet-wired", "not-yet-verified"]}
        }
      }
    },
    "demoCommands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "command", "expected"],
        "properties": {
          "name": {"type": "string"},
          "command": {"type": "string"},
          "expected": {"type": "string"}
        }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim", "evidenceClass", "status"],
        "properties": {
          "claim": {"type": "string"},
          "evidenceClass": {"enum": ["Code/file-verified", "Schema/contract-verified", "Test/CI-verified", "Dossier-supported", "Architecturally inferred", "Not yet verified from reviewed repository contents"]},
          "status": {"enum": ["live", "validated", "simulated", "record-only", "not-yet-wired", "not-yet-verified"]}
        }
      }
    }
  }
}
